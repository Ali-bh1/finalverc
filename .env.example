# ── Access tokens ────────────────────────────────────────────
# Signs the magic links. Generate once and never rotate casually —
# changing it invalidates every link already in customers' inboxes.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=

# ── Razorpay ─────────────────────────────────────────────────
# Dashboard → Settings → Webhooks → add https://tejaldesae.com/api/razorpay-webhook
# subscribed to `payment.captured`. This is the secret shown there.
RAZORPAY_WEBHOOK_SECRET=

# ── Where the links point ────────────────────────────────────
SITE_ORIGIN=https://tejaldesae.com

# ── KV store (Vercel KV or Upstash Redis) ────────────────────
# Only used for "resend my link" and rate limiting.
# Vercel KV sets the first pair for you when you link the store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Outgoing email ───────────────────────────────────────────
# Used by /api/eq-submit to send Expansion Quotient results.
# For testing with Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=<the gmail address>, SMTP_PASS=<a 16-character App Password
# from myaccount.google.com/apppasswords>, and MAIL_FROM must use that
# same address. Switch to the tejaldesae.com mailbox for launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tejal Desae <hello@tejaldesae.com>

# Where the team copy of every Expansion Quotient goes.
# Every submission (all answers + contact details) goes here.
EQ_NOTIFY_TO=hello@tejaldesae.com
